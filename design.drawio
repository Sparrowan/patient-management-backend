                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_auth_db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="1" source="auth" target="authdb" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_patient_db" value="writes +&lt;br&gt;fresh reads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" parent="1" source="patient" target="patientdb" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_patient_replica" value="read-only txns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="patient" target="patientreplica" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="290" y="395"/>
                            <mxPoint x="290" y="653"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_replication" value="binlog replication" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;strokeColor=#82b366;" parent="1" source="patientdb" target="patientreplica" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_billing_db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="1" source="billing" target="billingdb" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_analytics_db" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" parent="1" source="analytics" target="analyticsdb" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_grpc" value="gRPC (mTLS)&lt;br&gt;CloseAccountForPatient&lt;br&gt;&lt;i&gt;synchronous delete veto&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;strokeColor=#b85450;strokeWidth=2;fontColor=#b85450;" parent="1" source="patient" target="billing" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_outbox" value="outbox relay&lt;br&gt;PatientRegistered / PatientDeleted" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;strokeColor=#d79b00;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;" parent="1" source="patient" target="kafka" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="435" y="740"/>
                            <mxPoint x="640" y="740"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="e_kafka_billing" value="consume → open account&lt;br&gt;&lt;i&gt;idempotent&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;strokeColor=#d79b00;strokeWidth=2;" parent="1" source="kafka" target="billing" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="e_kafka_analytics" value="consume → project&lt;br&gt;&lt;i&gt;own consumer group&lt;/i&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;dashed=1;strokeColor=#d79b00;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;" parent="1" source="kafka" target="analytics" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="1180" y="830"/>
                            <mxPoint x="1180" y="395"/>
                        </Array>
                    </mxGeometry>
                </mxCell>
                <mxCell id="legend" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;—— synchronous HTTP / gRPC call (caller waits)&lt;br&gt;- - - asynchronous or infrastructure (events, cache, replication)&lt;br&gt;&lt;font color=&quot;#b85450&quot;&gt;——&lt;/font&gt; the one synchronous cross-service &lt;i&gt;veto&lt;/i&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Rule this diagram encodes:&lt;/b&gt; gate synchronously, propagate asynchronously.&lt;br&gt;One authoritative check the user waits on → sync command (the red edge).&lt;br&gt;Fan-out to whoever cares → events (the orange edges).&lt;br&gt;&lt;br&gt;&lt;b&gt;No shared database.&lt;/b&gt; Every pattern here (outbox, saga, idempotency,&lt;br&gt;CQRS) exists to buy back correctness that a single DB gave for free." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f9f9f9;strokeColor=#cccccc;align=left;verticalAlign=top;fontSize=11;spacing=8;" parent="1" vertex="1">
                    <mxGeometry x="10" y="760" width="480" height="190" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>