# Template for this service's environment-specific config. Copy to `.env` for LOCAL dev
# (spring-dotenv loads it; `.env` is git-ignored). Prod injects real env vars + secrets from a
# secrets manager. Every var has a safe default in application.properties.

# --- Database (per-service MariaDB) ---
DB_URL=jdbc:mariadb://localhost:3306/auth_db
DB_USERNAME=root
DB_PASSWORD=

# --- Distributed tracing: OTLP endpoint (Jaeger) + sample rate. Local default assumes Jaeger on
#     localhost; docker-compose overrides to the container (http://jaeger:4318/v1/traces). Sample
#     1.0 (everything) in dev; prod lowers it. ---
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
TRACING_SAMPLE_PROBABILITY=1.0

# Connection-pool sizing (per JVM): replicas x DB_POOL_MAX < max_connections - headroom.
# Smaller is usually better -- a deep pool does not add database capacity, it hides the queue.
DB_POOL_MAX=8
DB_POOL_MIN_IDLE=2
# Threads for @Scheduled jobs. Spring's default is ONE, which serialises them.
SCHEDULING_POOL_SIZE=4

# --- Default-admin seeding (LOCAL DEV ONLY) ---
# Creates admin/password with ROLE_ADMIN on an empty database. ROLE_ADMIN gates every money
# movement, so this must never be true in a shared or production environment. Defaults to false:
# the unsafe option requires a deliberate opt-in rather than remembering to disable it.
SEED_DEFAULT_ADMIN=true

# --- JWT signing key ---
# Unset = an ephemeral key generated at start-up. Locally that is convenient; anywhere with more
# than one instance or a restart that matters it is broken, because every restart invalidates all
# live tokens and two replicas sign with different keys. Point this at a mounted secret holding a
# private JWK (JSON) in any shared environment, e.g.:
#   JWT_KEY_LOCATION=file:/run/secrets/jwt-signing-key.json
JWT_KEY_LOCATION=
