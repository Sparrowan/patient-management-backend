# analytics-service — local-dev environment (spring-dotenv loads this; it is git-ignored).
# Only environment-varying config lives here; behavioral config stays in application.properties.
# Copy to .env and adjust as needed.

# Active Spring profile (dev locally; compose sets 'docker').
SPRING_PROFILES_ACTIVE=dev

# Datasource — analytics-service owns its own database (the read side never shares the write store).
DB_URL=jdbc:mariadb://localhost:3306/analytics_db
DB_USERNAME=root
DB_PASSWORD=

# Replication factor for the Kafka topics this service provisions. Must not exceed the broker
# count: local dev is a single-broker KRaft node, so 1. Production uses 3 (with
# min.insync.replicas=2), which is what gives the producer's acks=all real durability.
KAFKA_TOPIC_REPLICATION_FACTOR=1

# Connection-pool sizing (per JVM): replicas x DB_POOL_MAX < max_connections - headroom.
# Smaller is usually better -- a deep pool does not add database capacity, it hides the queue.
DB_POOL_MAX=8
DB_POOL_MIN_IDLE=2
# Threads for @Scheduled jobs. Spring's default is ONE, which serialises them.
SCHEDULING_POOL_SIZE=4
