# Template for this service's ENVIRONMENT-SPECIFIC config (the values that change dev→prod).
# Copy to `.env` for LOCAL dev — spring-dotenv loads `.env` automatically; it's git-ignored, so
# real secrets never get committed.
#
# PROD does NOT use a `.env` file: the orchestrator (docker-compose / k8s) injects these as real
# environment variables, and secrets (DB_PASSWORD) come from a secrets manager (Vault / k8s
# Secrets), never a file. Every var below has a safe default in application.properties — setting
# it here only OVERRIDES for this environment. Invariant/behavioral config (ddl-auto, Flyway,
# pagination caps, mTLS policy, gRPC server port) deliberately stays in application.properties.

# --- Database (per-service MariaDB) ---
DB_URL=jdbc:mariadb://localhost:3306/billing_db
DB_USERNAME=root
DB_PASSWORD=

# --- Active Spring profile: `dev` locally; `docker`/`prod` elsewhere (switches logs to JSON etc.) ---
SPRING_PROFILES_ACTIVE=dev

# --- Event backbone: Kafka broker + Schema Registry. Local defaults assume the compose infra is
#     reachable on localhost; docker-compose overrides these to the in-network hostnames
#     (kafka:9092, http://schema-registry:8081). ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SCHEMA_REGISTRY_URL=http://localhost:8081

# --- Distributed tracing: OTLP endpoint (Jaeger) + sample rate. Local default assumes Jaeger on
#     localhost; docker-compose overrides to the container (http://jaeger:4318/v1/traces). Sample
#     1.0 (everything) in dev; prod lowers it. ---
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces
TRACING_SAMPLE_PROBABILITY=1.0

# Replication factor for the Kafka topics this service provisions. Must not exceed the broker
# count: local dev is a single-broker KRaft node, so 1. Production uses 3 (with
# min.insync.replicas=2), which is what gives the producer's acks=all real durability.
KAFKA_TOPIC_REPLICATION_FACTOR=1

# Connection-pool sizing (per JVM): replicas x DB_POOL_MAX < max_connections - headroom.
# Smaller is usually better -- a deep pool does not add database capacity, it hides the queue.
DB_POOL_MAX=8
DB_POOL_MIN_IDLE=2
# Threads for @Scheduled jobs. Spring's default is ONE, which serialises them.
SCHEDULING_POOL_SIZE=4
